{
  "schema_version": "1.0",
  "rules": [
    {
      "id": "PY-STRING-001",
      "title": "字符串字面量禁止 Unicode 前缀",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "curated_policy",
      "conditions": ["提交到 ModSDK 包体的 Python 源文件包含字符串字面量"],
      "do": ["源文件使用 UTF-8", "字符串统一使用无前缀的单引号或双引号字面量"],
      "avoid": ["使用 u、U、ur 或 ru 字符串前缀", "通过拼接或生成代码绕过检查"],
      "positive_examples": ["name = \"中文名称\"", "pattern = r\"^[a-z_]+$\""],
      "negative_examples": ["name = u\"中文名称\"", "pattern = ur\"^[a-z_]+$\""],
      "keywords": ["unicode prefix", "字符串前缀", "u-string", "ur-string"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": "python.unicode_prefix"
    },
    {
      "id": "PY-COMPAT-001",
      "title": "业务脚本保持 Python 2.7 语法兼容",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["代码会由 ModSDK Python 运行环境加载"],
      "do": ["使用 Python 2.7 可解析的语法", "使用 % 或 str.format 完成字符串格式化"],
      "avoid": ["f-string", "函数或变量类型注解", "async/await", "海象运算符", "match/case"],
      "positive_examples": ["message = \"player=%s\" % player_id", "message = \"player={}\".format(player_id)"],
      "negative_examples": ["message = f\"player={player_id}\"", "def handle(value: int) -> None: pass"],
      "keywords": ["Python 2.7", "f-string", "type hints", "async", "语法兼容"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": "python.python3_syntax"
    },
    {
      "id": "PY-ENCODING-001",
      "title": "Python 源文件统一使用 UTF-8",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "curated_policy",
      "conditions": ["Python 源文件会作为 ModSDK 产物加载"],
      "do": ["以 UTF-8 保存文件", "需要兼容旧加载器时在文件前两行声明 UTF-8 编码"],
      "avoid": ["依赖操作系统默认编码", "以本地代码页保存源文件"],
      "positive_examples": ["# -*- coding: utf-8 -*-"],
      "negative_examples": ["文件使用本地代码页且没有编码声明"],
      "keywords": ["UTF-8", "coding", "编码", "乱码"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": "python.encoding"
    },
    {
      "id": "PY-IMPORT-001",
      "title": "外部模块导入采用 456 项精确白名单",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["导入目标不是当前组件明确声明的自身模块"],
      "do": ["按完整模块路径查询仓库白名单快照", "未命中时默认拒绝"],
      "avoid": ["根据磁盘存在、本地可运行或常见标准库身份推断许可", "随包内嵌第三方库绕过审核"],
      "positive_examples": ["import json", "import mod.client.extraClientApi"],
      "negative_examples": ["import os", "import requests"],
      "keywords": ["模块白名单", "import", "default deny", "精确路径"],
      "source_ids": ["netease-python-module-whitelist"],
      "detector": "python.import_whitelist"
    },
    {
      "id": "PY-IMPORT-002",
      "title": "白名单包前缀不构成通配许可",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["导入点位于白名单包或官方命名空间下"],
      "do": ["验证导入语句最终解析的完整模块路径"],
      "avoid": ["因父包在白名单中而放行任意子模块", "因模块名称以 mod.client 或 mod.server 开头而自动放行"],
      "positive_examples": ["仅当完整路径命中快照时放行"],
      "negative_examples": ["把 mod.client.* 当作通配白名单"],
      "keywords": ["包前缀", "子模块", "通配", "mod.client", "mod.server"],
      "source_ids": ["netease-python-module-whitelist"],
      "detector": "python.import_whitelist"
    },
    {
      "id": "PY-IMPORT-003",
      "title": "组件自身模块必须显式声明根包",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "error",
      "enforcement": "warn",
      "authority": "curated_policy",
      "conditions": ["白名单检查需要识别当前组件自身模块"],
      "do": ["由调用方显式传入自身根包", "只放行该根包本身及其点号子路径"],
      "avoid": ["根据当前工作目录自动猜测自身模块", "把相似前缀误判为自身模块"],
      "positive_examples": ["根包为 demo 时放行 demo 与 demo.client"],
      "negative_examples": ["根包为 demo 时放行 demo_extra"],
      "keywords": ["local module", "自身模块", "根包", "显式声明"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": "python.import_whitelist"
    },
    {
      "id": "PY-DYNAMIC-001",
      "title": "禁止绕过静态白名单的动态导入",
      "domain": "python",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "curated_policy",
      "conditions": ["业务代码尝试在运行时解析或加载 Python 模块"],
      "do": ["使用白名单中可静态审查的 import 语句", "需要加载项目模块时显式声明根包"],
      "avoid": ["调用 __import__、importlib.import_module 或 imp.load_*", "通过函数别名绕过静态检查"],
      "positive_examples": ["import json"],
      "negative_examples": ["loader = __import__; module = loader(name)"],
      "keywords": ["动态导入", "__import__", "importlib", "imp.load", "白名单绕过"],
      "source_ids": ["curated-modsdk-engineering-practices", "netease-python-module-whitelist"],
      "detector": "python.dynamic_import"
    },
    {
      "id": "PY-EVENT-001",
      "title": "官方事件回调字段必须与结构化文档一致",
      "domain": "api_event",
      "sides": ["client", "server"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["ListenForEvent 注册了官方事件回调且代码访问事件参数"],
      "do": ["按事件端侧读取当前快照的结构化参数", "同名多端事件分别核对字段"],
      "avoid": ["沿用旧字段名", "根据相似事件猜测字段"],
      "positive_examples": ["ServerItemUseOnEvent 使用 args.get(\"entityId\")"],
      "negative_examples": ["ServerItemUseOnEvent 使用 args.get(\"playerId\")"],
      "keywords": ["事件字段", "ListenForEvent", "entityId", "playerId", "参数签名"],
      "source_ids": ["netease-modsdk-api-docs", "netease-modsdk-39-release"],
      "detector": "python.event_fields"
    },
    {
      "id": "PY-PRINT-001",
      "title": "仅在确认的高频上下文警告刷屏日志",
      "domain": "performance",
      "sides": ["client", "server"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "warning",
      "enforcement": "warn",
      "authority": "curated_policy",
      "conditions": ["print 位于 Tick、逐帧循环或已确认的高频事件回调"],
      "do": ["使用稳定前缀并按诊断需求节流", "低频生命周期日志可直接保留"],
      "avoid": ["全局禁止 print", "在每帧或大循环内无条件刷屏"],
      "positive_examples": ["print(\"[Demo] initialized\")"],
      "negative_examples": ["def OnScriptTickServer(self): print(\"tick\")"],
      "keywords": ["print", "Tick", "高频事件", "日志", "刷屏"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": "python.high_frequency_print"
    }
  ]
}
