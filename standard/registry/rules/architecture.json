{
  "schema_version": "1.0",
  "rules": [
    {
      "id": "ARCH-SIDE-001",
      "title": "客户端与服务端导入边界必须分离",
      "domain": "architecture",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python", "mixed"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["Python 模块被明确加载到客户端、服务端或共享层"],
      "do": ["客户端只导入客户端可用模块", "服务端只导入服务端可用模块", "共享层只依赖双方都可加载的模块"],
      "avoid": ["客户端直接导入服务端 API", "服务端直接导入客户端 API", "共享模块在导入期触发单端依赖"],
      "positive_examples": ["客户端使用 mod.client.extraClientApi", "服务端使用 mod.server.extraServerApi"],
      "negative_examples": ["客户端模块导入 mod.server.extraServerApi", "服务端模块导入 mod.client.extraClientApi"],
      "keywords": ["客户端", "服务端", "side", "extraClientApi", "extraServerApi"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": "python.cross_side_import"
    },
    {
      "id": "ARCH-CROSS-001",
      "title": "跨端协作通过公开事件通道传递",
      "domain": "api_event",
      "sides": ["client", "server", "cross_side"],
      "artifact_types": ["python", "mixed"],
      "versions": ["3.9", "3.10"],
      "severity": "error",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["功能需要在客户端与服务端之间同步状态或请求"],
      "do": ["使用官方事件注册、监听和通知接口", "明确事件名、方向和载荷字段"],
      "avoid": ["跨端直接持有系统对象", "依赖共享进程内存", "把客户端展示状态当作服务端权威状态"],
      "positive_examples": ["客户端请求由事件发送，服务端校验后返回结果事件"],
      "negative_examples": ["客户端直接调用服务端组件实例"],
      "keywords": ["跨端", "事件", "NotifyToServer", "NotifyToClient", "权威状态"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": null
    },
    {
      "id": "ARCH-API-001",
      "title": "API 与事件签名必须按目标版本文档核验",
      "domain": "api_event",
      "sides": ["client", "server", "common", "cross_side"],
      "artifact_types": ["python", "behavior_json", "resource_json", "ui_python", "mixed"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["代码新增或修改 ModSDK API、事件、枚举或组件调用"],
      "do": ["查目标条目的公开签名、端侧、参数和返回值", "保留来源标识以便复核"],
      "avoid": ["凭名称猜参数", "把其他版本或国际版签名直接当作网易结论"],
      "positive_examples": ["生成代码前查询具体 API 条目并按文档参数调用"],
      "negative_examples": ["仅凭相似 API 名称拼出调用"],
      "keywords": ["API", "事件参数", "签名", "版本", "文档优先"],
      "source_ids": ["netease-modsdk-api-docs", "netease-modsdk-39-release"],
      "detector": null
    },
    {
      "id": "ARCH-COMPONENT-001",
      "title": "高频路径复用稳定工厂与组件引用",
      "domain": "performance",
      "sides": ["client", "server"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "warning",
      "enforcement": "guide",
      "authority": "curated_policy",
      "conditions": ["同一帧循环、Tick 或高频事件重复创建相同工厂或稳定组件"],
      "do": ["在生命周期清晰的位置复用稳定引用", "失效时显式重建"],
      "avoid": ["在每次循环中无条件重复获取工厂", "跨生命周期永久缓存可能失效的实体组件"],
      "positive_examples": ["系统初始化时保存工厂，实体组件按实体生命周期获取"],
      "negative_examples": ["遍历每个实体时重复调用 GetEngineCompFactory"],
      "keywords": ["GetEngineCompFactory", "缓存", "高频", "组件生命周期"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": null
    },
    {
      "id": "ARCH-TICK-001",
      "title": "高频事件必须控制工作量和执行频率",
      "domain": "performance",
      "sides": ["client", "server"],
      "artifact_types": ["python"],
      "versions": ["3.9", "3.10"],
      "severity": "warning",
      "enforcement": "warn",
      "authority": "curated_policy",
      "conditions": ["监听 Tick、逐帧更新或高频实体事件"],
      "do": ["按业务时效设置明确节流周期", "限制每轮处理数量", "记录低频性能诊断"],
      "avoid": ["无条件全量扫描", "把某个固定质数间隔当作所有业务的普遍要求", "逐帧打印日志"],
      "positive_examples": ["每 10 帧处理一批待更新对象并限制批量"],
      "negative_examples": ["每帧遍历所有在线实体并输出日志"],
      "keywords": ["Tick", "逐帧", "节流", "批处理", "性能"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": null
    },
    {
      "id": "ARCH-LIFECYCLE-001",
      "title": "异步任务和监听器跟随所属生命周期清理",
      "domain": "architecture",
      "sides": ["client", "server", "common"],
      "artifact_types": ["python", "ui_python"],
      "versions": ["3.9", "3.10"],
      "severity": "warning",
      "enforcement": "warn",
      "authority": "curated_policy",
      "conditions": ["对象注册事件、定时器、延迟回调或保存运行时节点引用"],
      "do": ["在销毁、换代或失效时取消任务并清除引用", "延迟回调执行前验证所属对象仍有效"],
      "avoid": ["让旧回调访问已销毁对象", "永久缓存需要重建的运行时节点"],
      "positive_examples": ["Destroy 中取消定时器并清理事件绑定"],
      "negative_examples": ["界面关闭后旧定时器继续写控件"],
      "keywords": ["生命周期", "timer", "监听器", "销毁", "旧回调"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": null
    },
    {
      "id": "ARCH-PORTABILITY-001",
      "title": "通用规则和产物不得耦合单机工作区",
      "domain": "architecture",
      "sides": ["client", "server", "common", "cross_side"],
      "artifact_types": ["python", "behavior_json", "resource_json", "manifest_json", "ui_json", "ui_python", "ui_defs_json", "mixed"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "curated_policy",
      "conditions": ["内容会进入共享标准、生成模板、指导输出或发布包", "由 registry 与 guidance 边界的确定性文本匹配执行，不注册产物 detector"],
      "do": ["使用仓库相对路径、稳定标识和调用方参数", "只保留跨项目成立的规则"],
      "avoid": ["写入开发机绝对路径", "写入团队、组件、业务或用户专名", "把单项目目录结构当作通用结构"],
      "positive_examples": ["standard/registry/rules/python.json", "由调用方传入目标包根目录"],
      "negative_examples": ["<LOCAL_WORKSPACE>/component", "在规则中硬编码某个业务组件名"],
      "keywords": ["可移植", "绝对路径", "本地耦合", "业务专名", "通用规则"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": null
    },
    {
      "id": "ARCH-UPSTREAM-001",
      "title": "国际版和社区资料不得直接证明网易兼容",
      "domain": "architecture",
      "sides": ["client", "server", "common", "cross_side"],
      "artifact_types": ["python", "behavior_json", "resource_json", "manifest_json", "ui_json", "mixed"],
      "versions": ["3.9", "3.10"],
      "severity": "error",
      "enforcement": "warn",
      "authority": "curated_policy",
      "conditions": ["实现依据来自 Bedrock 国际版样本、社区 Wiki 或其他非网易资料"],
      "do": ["把上游资料标为参考", "再用网易文档或目标运行环境复核兼容性"],
      "avoid": ["将上游存在直接表述为网易支持", "用较新上游版本覆盖目标版本边界"],
      "positive_examples": ["上游资料说明概念，网易文档确认最终字段"],
      "negative_examples": ["国际版样本可运行，因此直接声明网易支持"],
      "keywords": ["Bedrock", "国际版", "社区", "兼容性", "来源边界"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": null
    },
    {
      "id": "MULTIPLAYER-AUTHORITY-001",
      "title": "联机业务状态由服务端校验并定向同步",
      "domain": "multiplayer",
      "sides": ["client", "server", "cross_side"],
      "artifact_types": ["python", "mixed"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["客户端请求会修改物品、货币、权限、进度或其他联机权威状态"],
      "do": ["服务端校验玩家、权限、参数和当前状态", "结果优先定向通知相关客户端", "广播前明确真实接收范围"],
      "avoid": ["直接信任客户端提交的结果值", "用客户端展示状态代替服务端状态", "无条件向全部客户端广播私有结果"],
      "positive_examples": ["客户端发送操作意图，服务端计算结果后定向返回"],
      "negative_examples": ["客户端直接提交最终余额并要求服务端保存"],
      "keywords": ["联机", "多人", "服务端权威", "定向同步", "广播", "客户端请求"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": null
    }
  ]
}
