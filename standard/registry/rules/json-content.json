{
  "schema_version": "1.0",
  "rules": [
    {
      "id": "JSON-PARSE-001",
      "title": "JSON 产物必须符合目标加载器语法",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json", "resource_json", "manifest_json", "ui_json", "ui_defs_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["生成或修改由游戏加载的 JSON 文件"],
      "do": ["按目标文件类型使用官方记录的语法", "提交前完成确定性解析"],
      "avoid": ["混入目标加载器未声明支持的语法扩展", "依赖编辑器自动修复无效 JSON"],
      "positive_examples": ["对象、数组、字符串和数字均能由目标解析器完整读取"],
      "negative_examples": ["缺失逗号或括号", "使用未记录的扩展语法"],
      "keywords": ["JSON", "解析", "语法", "加载器"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": "json.parse"
    },
    {
      "id": "JSON-FORMAT-001",
      "title": "format_version 按具体产物和目标版本选择",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json", "resource_json", "manifest_json", "ui_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["目标 JSON 类型声明或要求 format_version"],
      "do": ["查阅该产物类型的 目标版本官方说明", "保留文件类型对应的精确版本值"],
      "avoid": ["为所有物品、方块、实体和清单复用一个版本值", "照搬其他版本或国际版示例的版本值"],
      "positive_examples": ["分别核验 manifest、物品和方块的格式版本"],
      "negative_examples": ["全项目无条件替换为同一个 format_version"],
      "keywords": ["format_version", "manifest", "物品", "方块", "版本"],
      "source_ids": ["netease-modsdk-api-docs", "netease-modsdk-39-release"],
      "detector": null
    },
    {
      "id": "JSON-ID-001",
      "title": "自定义内容标识符必须使用稳定命名空间",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json", "resource_json", "manifest_json", "ui_json", "ui_defs_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["定义自定义物品、方块、实体、资源或 UI 画布标识"],
      "do": ["使用项目声明的稳定命名空间", "保证引用端与定义端完全一致"],
      "avoid": ["省略命名空间", "在文件间混用大小写或临时名称", "占用原生命名空间"],
      "positive_examples": ["demo:sample_item", "demo_ui.main"],
      "negative_examples": ["sample_item", "minecraft:custom_item"],
      "keywords": ["identifier", "namespace", "命名空间", "标识符"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": "json.identifier"
    },
    {
      "id": "JSON-PATH-001",
      "title": "JSON 文件必须位于对应行为包或资源包目录",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json", "resource_json", "manifest_json", "ui_json", "ui_defs_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["文件类型由包目录决定加载方式"],
      "do": ["按官方目录约定放入行为包或资源包", "让引用路径与包内相对路径一致"],
      "avoid": ["把资源文件放进行为包", "把行为定义放进资源包", "依赖开发工具的工作区路径代替包内路径"],
      "positive_examples": ["UI 定义和 UI JSON 位于资源包 ui 目录"],
      "negative_examples": ["把 _ui_defs.json 放在资源包根目录"],
      "keywords": ["行为包", "资源包", "路径", "ui", "目录"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": null
    },
    {
      "id": "JSON-MANIFEST-001",
      "title": "manifest 模块、依赖和 UUID 必须自洽",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["manifest_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["创建或修改行为包、资源包或脚本模块清单"],
      "do": ["保证 header 与 modules UUID 唯一", "依赖 UUID 和版本与目标包匹配", "按模块类型填写入口"],
      "avoid": ["复制示例 UUID 后直接发布", "声明不存在的依赖", "把脚本入口写到错误模块类型"],
      "positive_examples": ["行为包依赖精确指向配套资源包 header UUID"],
      "negative_examples": ["header 与 module 使用同一 UUID"],
      "keywords": ["manifest", "UUID", "dependencies", "modules", "entry"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": null
    },
    {
      "id": "JSON-COMPONENT-001",
      "title": "组件名、字段和枚举必须逐项查证",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json", "resource_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "warn",
      "authority": "official_doc",
      "conditions": ["JSON 新增或修改组件、字段、事件响应或枚举值"],
      "do": ["核对 目标版本官方组件文档", "保留字段类型、默认值和适用对象"],
      "avoid": ["按相似名称猜组件", "把国际版新组件直接用于网易包", "忽略字段端侧或实验性条件"],
      "positive_examples": ["使用前查询组件定义及完整属性"],
      "negative_examples": ["从其他版本样本复制未知字段"],
      "keywords": ["component", "组件", "字段", "枚举", "实验性"],
      "source_ids": ["netease-modsdk-api-docs", "netease-modsdk-39-release"],
      "detector": null
    },
    {
      "id": "JSON-REFERENCE-001",
      "title": "上游 JSON 样本只能作为参考来源",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json", "resource_json", "manifest_json", "ui_json"],
      "versions": ["3.9", "3.10"],
      "severity": "error",
      "enforcement": "warn",
      "authority": "curated_policy",
      "conditions": ["方案引用国际版样本或社区教程"],
      "do": ["标注参考来源", "用目标版本网易文档重新核验最终字段和版本"],
      "avoid": ["把上游 schema 通过视为网易兼容", "生成网易文档不存在的字段"],
      "positive_examples": ["参考上游结构后，仅保留网易文档确认的字段"],
      "negative_examples": ["直接复制较新国际版文件并宣称兼容"],
      "keywords": ["上游样本", "Bedrock", "schema", "网易兼容", "JSON"],
      "source_ids": ["curated-modsdk-engineering-practices"],
      "detector": null
    },
    {
      "id": "JSON-ITEM-FORMAT-001",
      "title": "基础物品使用官方 1.10 格式结构",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["产物根对象包含 minecraft:item"],
      "do": ["基础物品使用 format_version 1.10", "在 description 中提供 namespaced identifier"],
      "avoid": ["把未核验的现代物品结构套用到基础生成器", "省略必需标识符"],
      "positive_examples": ["format_version 为 1.10 且包含 minecraft:item.description.identifier"],
      "negative_examples": ["format_version 为 1.19.20 的基础物品产物"],
      "keywords": ["minecraft:item", "物品", "format_version", "1.10", "identifier"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": "json.item_format"
    },
    {
      "id": "JSON-BLOCK-FORMAT-001",
      "title": "方块 format profile 与组件形状必须匹配",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["产物根对象包含 minecraft:block 且 profile 可确定"],
      "do": ["在 legacy_1_10、scalar_1_16、modern_1_19_20 中显式选择", "保持版本与组件值形状一致"],
      "avoid": ["设置全局唯一 format_version", "混用旧式光照字段和现代 destructible 组件"],
      "positive_examples": ["modern_1_19_20 使用数值 light_emission 与 destructible_by_mining 对象"],
      "negative_examples": ["1.10 方块使用标量 destroy_time"],
      "keywords": ["minecraft:block", "方块", "format profile", "legacy_1_10", "modern_1_19_20"],
      "source_ids": ["netease-modsdk-api-docs"],
      "detector": "json.block_profile"
    },
    {
      "id": "JSON-BIOME-001",
      "title": "3.9 起自定义维度 biome_type 必须带命名空间",
      "domain": "json_content",
      "sides": ["common"],
      "artifact_types": ["behavior_json"],
      "versions": ["3.9", "3.10"],
      "severity": "critical",
      "enforcement": "block",
      "authority": "official_doc",
      "conditions": ["3.9 起自定义维度配置包含 biome_type"],
      "do": ["使用完整 namespace:id"],
      "avoid": ["只写裸群系名称"],
      "positive_examples": ["\"biome_type\": \"demo:crystal_biome\""],
      "negative_examples": ["\"biome_type\": \"crystal_biome\""],
      "keywords": ["biome_type", "自定义维度", "群系", "namespace:id", "3.9"],
      "source_ids": ["netease-modsdk-39-release", "netease-modsdk-api-docs"],
      "detector": "json.biome_namespace"
    }
  ]
}
